{
  "name": "floor-limiter",
  "description": "Floor-triggered session compaction for DeepSeek Harness: compact old history once M real user floors accumulate, keeping the newest N verbatim",
  "version": "0.1.2",
  "license": "MIT",
  "author": "MengXinSu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MengXinSu/floor-limiter.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "compaction",
    "context-management",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    },
    "compatibility": {
      "dsh": ">=0.1.7-rc.1 <0.2.0",
      "dshReleases": {
        "0.1.5-rc.3": "incompatible",
        "0.1.7-alpha.1": "unknown",
        "0.1.7-alpha.2": "unknown",
        "0.1.7-rc.1": "compatible",
        "0.1.7-rc.2": "compatible"
      },
      "node": ">=20.18",
      "profiles": [
        "web"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "tsx tests/selftest.ts"
  },
  "devDependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/dsh-agent": "0.1.7-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-locale": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-store": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "0.1.7-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "0.1.7-rc.2",
    "@deepseek-ai/dsh-compaction": "0.1.7-rc.2",
    "@deepseek-ai/dsh-session": "0.1.7-rc.2",
    "@deepseek-ai/dsh-settings": "0.1.7-rc.2",
    "@deepseek-ai/schemastery": "~3.18.4",
    "esbuild": "^0.28.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": ">=4.0.1 <5",
    "@deepseek-ai/dsh-agent": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-agent-preset-registry": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-compaction": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-session": ">=0.1.7-rc.1 <0.2.0",
    "@deepseek-ai/dsh-settings": ">=0.1.7-rc.1 <0.2.0"
  }
}
