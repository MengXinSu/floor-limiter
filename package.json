{
  "name": "floor-limiter",
  "description": "Floor-triggered session compaction for DeepSeek Harness: compact old history once M real user floors accumulate, keeping the newest N verbatim",
  "version": "0.1.1",
  "license": "MIT",
  "author": "MengXinSu",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MengXinSu/floor-limiter.git"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "compaction",
    "context-management",
    "plugin"
  ],
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-settings"
      ]
    }
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "dsh.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node build.mjs",
    "test": "tsx tests/selftest.ts"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2"
  }
}
